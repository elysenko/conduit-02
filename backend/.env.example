# Copy to backend/.env and fill in. Deployed pods get these from the `app-secrets` Secret.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001

# Optional object storage (surfaced on /admin/settings, resolved via resolveConfig()).
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="app-uploads"

# Injected by Colossus at provision — one platform login per contract role.
COLOSSUS_ACCOUNTS_JSON='[{"role":"ADMIN","email":"admin@example.com","password":"…","login_path":"/login"}]'
